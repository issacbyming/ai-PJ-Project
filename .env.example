# APP 名稱 e.g. 聊天機器人
NEXT_PUBLIC_APP_NAME=XXXXXXXX

# 在這裡輸入你的 API URL e.g. https://api.example.com
NEXT_PUBLIC_API_BASE_URL=XXXXXXXX
# APP 的 Logo 圖片 URL
NEXT_PUBLIC_LOGO_URL=XXXXXXXX

# Chatbot 的預設問候標題
NEXT_PUBLIC_EMPTY_SCREEN_TITLE=XXXXXXXX
# Chatbot 的預設問候語
NEXT_PUBLIC_EMPTY_SCREEN_DESC=XXXXXXXX

# 跨年行程共編（/newyear）的雲端資料庫。兩個都填才會啟用多人共編；
# 沒填的話資料只會存在各自的瀏覽器。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
